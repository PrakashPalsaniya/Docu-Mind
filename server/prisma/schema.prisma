generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pdfs      Pdf[]
  chats     Chat[]
}

model Pdf {
  id            String    @id @default(uuid())
  name          String
  fileUrl       String
  status        PdfStatus @default(PROCESSING)
  statusMessage String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats     Chat[]
}

model Chat {
  id        String   @id @default(uuid())
  role      ChatRole
  content   String
  sources   Json?
  createdAt DateTime @default(now())
  pdfId     String
  pdf       Pdf      @relation(fields: [pdfId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ChatRole {
  USER
  AI
}

enum PdfStatus {
  PROCESSING
  READY
  FAILED
}
